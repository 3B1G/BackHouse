# Put real values in nessie_lab/.env (never commit it). All optional except the seed for `serve`.
ASI1_API_KEY=replace-with-your-asi-api-key      # enables LLM menu reading; without it a rule-based reader is used
ASI_MODEL=asi1
ASI_READ_TIMEOUT_SECONDS=120
APIFY_TOKEN=replace-with-your-apify-token       # enables live competitor discovery (Google Maps); without it the seed list is used
MARKET_SCOUT_SEED=replace-with-a-private-stable-seed
MARKET_SCOUT_MAILBOX=false
MARKET_SCOUT_LOCAL_CLIENT_ENDPOINT=http://127.0.0.1:8004/submit
MARKET_SCOUT_ALLOWED_SENDERS=                   # agent addresses serve accepts; empty = refuse to start unless --local-only
MARKET_SCOUT_LOCAL_CLIENT_SEED=                 # empty = random seed generated in data/market_scout/ (gitignored)
MARKET_SCOUT_BIND_HOST=127.0.0.1

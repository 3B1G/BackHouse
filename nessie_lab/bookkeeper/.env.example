ASI1_API_KEY=replace-with-your-asi-api-key
# asi1, asi1-mini (faster) or asi1-ultra
ASI_MODEL=asi1
# replies stream: these bound the silence between chunks, not a whole call
ASI_READ_TIMEOUT_SECONDS=120
ASI_REPORT_TIMEOUT_SECONDS=600
# a timed-out or dropped call is retried this many times, waiting backoff x attempt seconds
ASI_RETRIES=2
ASI_RETRY_BACKOFF_SECONDS=5
ASI_MAX_TOKENS=12000
ASI_REPORT_MAX_TOKENS=32000
BOOKKEEPER_CONCURRENCY=4
BOOKKEEPER_SEED=replace-with-a-private-stable-seed
BOOKKEEPER_MAILBOX=false
BOOKKEEPER_LOCAL_CLIENT_ENDPOINT=http://127.0.0.1:8002/submit
# Verifier: repeats the investigation independently and publishes the report
VERIFIER_SEED=replace-with-another-private-stable-seed
VERIFIER_MODEL=
VERIFIER_TEMPERATURE=0
# comparisons before the Verifier settles what is still disputed (each later one follows a Bookkeeper revision)
VERIFIER_MAX_ROUNDS=3
VERIFIER_MAILBOX=false
# Each agent's peer: set the address, or leave it empty to derive it from the peer's seed in this same .env
BOOKKEEPER_VERIFIER_ADDRESS=
BOOKKEEPER_VERIFIER_ENDPOINT=http://127.0.0.1:8003/submit
VERIFIER_BOOKKEEPER_ADDRESS=
VERIFIER_BOOKKEEPER_ENDPOINT=http://127.0.0.1:8001/submit

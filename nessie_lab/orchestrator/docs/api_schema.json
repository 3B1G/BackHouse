{
  "title": "BackHouse orchestrator HTTP API",
  "version": "0.1.0",
  "base_url": "http://127.0.0.1:8005",
  "auth": "Authorization: Bearer <contents of nessie_lab/data/orchestrator/rest_token> on every request (a fresh token each time `orchestrator serve` starts)",
  "cors": "only for the origins in ORCHESTRATOR_ALLOWED_ORIGINS (comma-separated, loopback only); never *",
  "money": "{cents: int, usd: '$1,234.56'}",
  "dates": "ISO YYYY-MM-DD",
  "errors": "ok=false with error (HTTP 200); 400 body does not match the request model; 401 no/wrong token; 403 origin, client or host refused; 413 body over 64 KiB",
  "no_approve_or_apply": "Nothing here approves or applies. To apply a suggestion, the owner runs its approve_command at their own terminal (CH asks for the owner passphrase).",
  "endpoints": [
    {
      "method": "GET",
      "path": "/api/health",
      "request": null,
      "response": "HealthResponse",
      "description": "Version, mode (local/mailbox), offline, delegation, whether the Market scout and Bookkeeper agents are reachable, and the Bookkeeper's coverage."
    },
    {
      "method": "GET",
      "path": "/api/brief",
      "request": null,
      "response": "BriefResponse",
      "description": "The deterministic brief as JSON plus its text. Read-only: it never writes a suggestion (fixes lists the pending ones)."
    },
    {
      "method": "POST",
      "path": "/api/ask",
      "request": "AskApiRequest",
      "response": "AskApiResponse",
      "description": "One owner turn through the figure guard: text, suggestion paths and their approve commands, degraded, notes. May write a pending suggestion; never approves."
    },
    {
      "method": "GET",
      "path": "/api/status",
      "request": null,
      "response": "StatusResponse",
      "description": "bookkeeper_status, the cost_price verify() summary and the number of pending suggestions."
    },
    {
      "method": "GET",
      "path": "/api/suggestions",
      "request": null,
      "response": "SuggestionsResponse",
      "description": "Pending suggestion files with CH's plan line, title, action, target, old/new price, effect, created time and approve_command (owner_action_required: true)."
    },
    {
      "method": "POST",
      "path": "/api/suggestions/preview",
      "request": "PreviewRequest",
      "response": "PreviewResponse",
      "description": "CH's dry-run plan and question line for one suggestion. Read-only."
    },
    {
      "method": "GET",
      "path": "/api/market",
      "request": null,
      "response": "MarketResponse",
      "description": "The latest saved market positions (no new scan)."
    },
    {
      "method": "POST",
      "path": "/api/forecast",
      "request": "ForecastRequest",
      "response": "ForecastResponse",
      "description": "A what-if forecast (contracts.Scenario): base and scenario run-out dates, vs_base, the monthly cash effect."
    },
    {
      "method": "GET",
      "path": "/api/menu",
      "request": null,
      "response": "MenuResponse",
      "description": "The dine-in dinner menu in force, each dish's food cost, and the menu's overall food cost %."
    },
    {
      "method": "GET",
      "path": "/api/bills",
      "request": null,
      "response": "BillsResponse",
      "description": "Pending bills from the Nessie sync, earliest first, with the total."
    }
  ],
